; Eldrath 3D — Godot 4.7.1 prototype
config_version=5

[application]
config/name="ELDRATH — The Nameless Tomb"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.008, 0.009, 0.012, 1)

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.009, 0.012, 1)

[physics]
3d/default_gravity=18.0
